# ======================================================================
# AI Crop Health - environment configuration EXAMPLE
# ======================================================================
# Copy this file to `.env` in the same directory as manage.py, then fill in
# real values. NEVER commit the real .env - it holds secrets.
#
#   cp .env.example .env
#
# Generate a SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ======================================================================


# ---------------------------------------------------------------- REQUIRED
# Django refuses to start without this.
SECRET_KEY=replace-me-with-a-generated-50-character-random-string


# ---------------------------------------------------------------- CORE
# "True" for local development, "False" for a real deployment.
# When False, Django enables HTTPS redirect, secure cookies, HSTS and the
# X-Forwarded-Proto check needed behind a reverse proxy.
DJANGO_DEBUG=True

# Comma-separated hostnames this site answers on. REQUIRED in production:
# Django returns HTTP 400 for any Host header not listed here.
# Local development falls back to 127.0.0.1,localhost when this is blank.
DJANGO_ALLOWED_HOSTS=

# Comma-separated origins allowed to submit forms, WITH the scheme.
# Required in production or every POST fails CSRF validation.
#   CSRF_TRUSTED_ORIGINS=https://farm.example.com,https://www.farm.example.com
CSRF_TRUSTED_ORIGINS=


# ---------------------------------------------------------------- STORAGE
# Where uploaded farmer photos are written. In production point this at a disk
# OUTSIDE the git checkout - media inside the repo is one deploy away from
# deletion, and Ask AI re-reads stored photos, so losing them breaks every past
# diagnosis. Blank uses <project>/media, which is fine locally.
MEDIA_ROOT=


# ---------------------------------------------------------------- SOCIAL LINKS
# Each one filled in here appears as an icon in the topbar and the footer.
# Blank means "we do not have one" and the icon is simply not rendered, so the
# bar never shows a link that goes nowhere.
SOCIAL_FACEBOOK=
SOCIAL_TWITTER=
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=
SOCIAL_TELEGRAM=
SOCIAL_GITHUB=
# Full https://wa.me/... link OR just the number with country code, e.g.
# 919876543210 - both work.
SOCIAL_WHATSAPP=

# Shown as a phone icon in the topbar. Blank hides it.
COMPANY_PHONE=


# ---------------------------------------------------------------- COMPANY
# Rendered into the privacy policy, terms and contact page. Change them here,
# never in the templates - the pages read these at request time.
COMPANY_NAME=The Sensing Squad Agritech Pvt. Ltd.
COMPANY_SHORT_NAME=AI Crop Health
COMPANY_ADDRESS=Kolkata, West Bengal, India
COMPANY_EMAIL=harekrishnahareramramram108@gmail.com
# Leave blank and the contact page simply omits the phone block.
COMPANY_PHONE=
COMPANY_JURISDICTION=India
COMPANY_COURTS_CITY=Kolkata, West Bengal
# SET THIS WHEN YOU DEPLOY. The privacy policy names your host automatically;
# until it is set the page says the app is not yet on a third-party host.
COMPANY_HOSTING_PROVIDER=
COMPANY_POLICY_UPDATED=6 October 2026


# ---------------------------------------------------------------- AI / ML KEYS
# Kindwise crop.health - PRIMARY disease diagnosis provider.
# Covers 23 major crops (rice, wheat, cotton, sugarcane, maize...) and ~300
# health issues, trained on field photos. The bundled offline model covers only
# 38 PlantVillage classes and NONE of the Indian staples, so without this key
# the app will confidently misdiagnose most crops a farmer actually grows.
# Get a key (100 free credits) at https://admin.kindwise.com
# Cost after that: roughly EUR 0.01-0.05 per diagnosis.
CROP_HEALTH_API_KEY=

# Set to False to force the offline model even when a key is present.
CROP_HEALTH_ENABLED=True
# Seconds to wait before giving up and falling back to the offline model.
CROP_HEALTH_TIMEOUT=12
# ISO 639-1 code for disease names and advice (en, hi, bn, ta, te, mr...).
CROP_HEALTH_LANGUAGE=en

# Kindwise insect.id - insect and invertebrate identification.
# 14,000+ taxa, about 92% top-3 accuracy. Same account as crop.health.
# Get a key at https://admin.kindwise.com
# Blank disables the insect page (it reports that honestly rather than guessing).
INSECT_ID_API_KEY=
INSECT_ID_ENABLED=True
INSECT_ID_TIMEOUT=12
INSECT_ID_LANGUAGE=en

# Groq - powers the "Ask AI" assistant on the diagnosis page.
# Free key at https://console.groq.com/keys
# Without this, Ask AI returns an error instead of answering.
GROQ_API_KEY=

# Image-capable model. Groq has no PRODUCTION vision model as of Oct 2026, so
# this one is from their preview tier; if it is withdrawn, Ask AI automatically
# falls back to GROQ_TEXT_MODEL and answers from the diagnosis text alone.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Production, text-only. The fallback.
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Gemini model for the chatbot fallback provider.
GEMINI_CHAT_MODEL=gemini-2.5-flash
GROQ_TIMEOUT=30

# Google Gemini - used to cross-check leaf diagnoses and for the chatbot.
# Get one at https://aistudio.google.com/apikey
# Leave blank to disable Gemini cross-validation (diagnosis still works).
GEMINI_API_KEY=

# OpenWeatherMap - weather panel and irrigation advice.
# Free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Optional extra agriculture data provider. Blank disables it.
AGRICULTURE_API_KEY=


# ---------------------------------------------------------------- LEAF DIAGNOSIS
# Temperature scaling for the plant-disease CNN's confidence.
# 1.0 means NO calibration: reported confidence is raw softmax and will be
# overconfident (a 38-class head routinely reports 99.9% on an ambiguous leaf).
# Fit a real value on a labelled validation split before trusting the number.
PLANT_DISEASE_TEMPERATURE=1.0


# ---------------------------------------------------------------- EMAIL
# In DEBUG the console backend is used and email is printed to the terminal,
# so these can stay blank for local development.
# For Gmail you must use an App Password, not your account password.
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False


# ---------------------------------------------------------------- SERVICES
# External detection microservice, if you run one. Defaults to localhost:8001.
ML_DETECTION_URL=http://127.0.0.1:8001/api/detect

# Contact string Nominatim/geocoding requires in its User-Agent header.
GEOCODING_USER_AGENT=ai-crop-health/1.0 (you@example.com)


# ---------------------------------------------------------------- DATABASE
# Leave DATABASE_URL blank to use SQLite (db.sqlite3) for local development.
#
# SQLite serialises every write and WILL raise "database is locked" once more
# than one sensor node POSTs at the same time. Set this to PostgreSQL before
# connecting real field hardware. Running DEBUG=False on SQLite logs a warning.
#
# Percent-encode special characters in the password (@ becomes %40).
#   DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Seconds to keep a database connection open for reuse. 0 disables pooling.
DB_CONN_MAX_AGE=600

# Require TLS to the database. Keep True for any managed/hosted Postgres.
# Set False only for a Postgres on localhost that does not speak TLS.
DB_REQUIRE_SSL=True


# ---------------------------------------------------------------- MONITORING
# Error tracking. Blank disables it entirely and the dependency stays optional.
#   pip install "sentry-sdk[django]"
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1


# ---------------------------------------------------------------- SITE IDENTITY
SITE_NAME=AI Crop Health
SITE_TAGLINE=AI crop disease diagnosis, land leasing and IoT field monitoring for farmers

# Image used for WhatsApp/Facebook/LinkedIn/X link previews.
# A 1200x630 default ships at assets/img/social-preview.png; override to swap it.
SOCIAL_PREVIEW_IMAGE=


# ---------------------------------------------------------------- SOCIAL PROFILES
# Full URLs. Each blank value HIDES that icon rather than rendering a dead link,
# so leave them empty until the profile actually exists.
SOCIAL_FACEBOOK=
SOCIAL_TWITTER=
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=
SOCIAL_WHATSAPP=


# ---------------------------------------------------------------- ANALYTICS
# Blank disables analytics completely and no script is ever loaded.
# Deliberately not Google Analytics: a cookieless, self-hostable tracker
# (Plausible, Umami, Fathom) avoids sending visitor data to a third party.
# Even when set, the script is injected ONLY after the visitor accepts in the
# cookie banner.
#   ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js
#   ANALYTICS_SITE_ID=farm.example.com
ANALYTICS_SCRIPT_URL=
ANALYTICS_SITE_ID=

# Kindwise crop.health API base URL (override only for a staging endpoint).
CROP_HEALTH_BASE_URL=https://crop.kindwise.com
